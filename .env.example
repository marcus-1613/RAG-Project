# ============================================
# DeepSeek API 配置（必填）
# ============================================

# DeepSeek API Key（到 https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=your_api_key_here

# DeepSeek API 地址（官方默认；如用第三方代理请改成对应地址）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek 模型名
DEEPSEEK_MODEL=deepseek-chat


# ============================================
# 可选配置（一般无需修改）
# ============================================

# Embedding 模型（本地 HuggingFace，中文语义检索）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# HuggingFace 镜像（国内网络下载慢/超时时可启用）
# HF_ENDPOINT=https://hf-mirror.com


# ============================================
# 检索配置
# ============================================
# 检索模式，可选：
#   vector        —— 仅向量检索（语义相似）
#   bm25          —— 仅关键词检索（专有名词更准）
#   hybrid        —— 向量 + BM25，用 RRF 融合【默认】
#   hybrid_rerank —— 在 hybrid 之上再用 Cross-Encoder 精排（更准但更慢）
RETRIEVAL_MODE=hybrid

# 最终送给大模型的文本块数量
TOP_K=5

# 每路检索各自召回的候选数量（融合前）。
# 必须大于 TOP_K，否则融合没有腾挪空间。
CANDIDATE_K=20

# RRF 融合的平滑常数（原论文经验值 60，一般不用改）
# RRF_K=60

# 是否启用 Cross-Encoder 精排（仅 hybrid_rerank 模式生效）
# 设为 false 可让 hybrid_rerank 退化为 hybrid，用于对比精排带来的增益
RERANK_ENABLED=true

# Cross-Encoder 重排模型（首次使用需下载，约 1GB）
# RERANK_MODEL=BAAI/bge-reranker-base
