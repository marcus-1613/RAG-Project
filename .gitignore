# 环境变量（含 API Key，绝对不能提交）
.env

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# 虚拟环境
.venv/
venv/
env/

# 数据文件（PDF 和向量库，运行时生成）
data/pdfs/*
data/chroma/*

# 保留 PDF 目录说明文件
!data/pdfs/README.md

# 测试缓存
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE
.vscode/
.idea/

# 本地工具目录与日志
.workbuddy/
*.log

# 系统文件
.DS_Store
Thumbs.db
